# Copy this file to `.env` and replace the values with your own.
# On Vercel, add the same variables in Project Settings > Environment Variables.
# Every variable is optional: if one is missing, the related content is hidden.
# Note: these values end up in the generated HTML, so only put public information here.

PUBLIC_LOCATION="City, Country"
PUBLIC_EMAIL="you@example.com"
PUBLIC_GITHUB_URL="https://github.com/your-username"
PUBLIC_INSTAGRAM_URL="https://www.instagram.com/your-username/"
PUBLIC_TIKTOK_URL="https://www.tiktok.com/@your-username"
