---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { LOCATION } from '../consts';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero container">
    <p class="eyebrow">Hi, I'm</p>
    <h1>Wu Zhoupeng</h1>
    <p class="lead">Developer based in {LOCATION}. I like building things with code.</p>
    <p class="actions">
      <a class="btn" href="/projects">See my projects</a>
      <a class="btn btn-outline" href="/contact">Get in touch</a>
    </p>
  </section>

  {
    featured.length > 0 && (
      <section class="container featured">
        <h2>Featured projects</h2>
        <div class="grid">
          {featured.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: 5rem 2rem;
    text-align: center;
  }
  .eyebrow {
    margin: 0;
    color: var(--h3);
    font-size: 1.5rem;
  }
  .lead {
    font-size: 1.35rem;
    max-width: 36rem;
    margin-inline: auto;
  }
  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  .featured {
    margin-top: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
  }
</style>
