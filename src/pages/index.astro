---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { LOCATION } from '../consts';

const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="container-site pt-20 pb-8 text-center">
    <p class="text-h3 m-0 text-2xl">Hi, I'm</p>
    <h1>Wu Zhoupeng</h1>
    <p class="mx-auto max-w-xl text-[1.35rem]">Developer based in {LOCATION}. I like building things with code.</p>
    <p class="mt-8 flex flex-wrap justify-center gap-4">
      <a class="btn" href="/projects">See my projects</a>
      <a class="btn btn-outline" href="/contact">Get in touch</a>
    </p>
  </section>

  {
    featured.length > 0 && (
      <section class="container-site mt-12">
        <h2>Featured projects</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(18rem,1fr))] gap-6">
          {featured.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  }
</Base>
