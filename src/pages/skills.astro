---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SKILL_GROUPS, type SkillGroup } from '../data/skills';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const education = await getCollection('education', ({ data }) => !data.draft);

const sources = [
  ...projects.map((e) => ({ kind: 'project' as const, href: `/projects/${e.id}`, title: e.data.title, tech: e.data.technologies })),
  ...education.map((e) => ({ kind: 'education' as const, href: `/education/${e.id}`, title: e.data.title, tech: e.data.technologies })),
];

const key = (s: string) => s.trim().toLowerCase();

// Technologies that appear in content but not in SKILL_GROUPS.
const known = new Set(SKILL_GROUPS.flatMap((g) => g.skills.map((s) => key(s.name))));
const extra = new Map<string, string>();
for (const s of sources) for (const t of s.tech) if (!known.has(key(t)) && !extra.has(key(t))) extra.set(key(t), t);

const groups: SkillGroup[] = [...SKILL_GROUPS];
if (extra.size > 0) groups.push({ title: 'Other', skills: [...extra.values()].sort().map((name) => ({ name })) });

const withUsage = groups.map((group) => ({
  title: group.title,
  skills: group.skills.map((skill) => {
    const used = sources.filter((s) => s.tech.some((t) => key(t) === key(skill.name)));
    const learning = used.length > 0 && used.every((u) => u.kind === 'education');
    return { ...skill, used, learning };
  }),
}));
---

<Base title="Skills" description="Languages, tools and technologies Wu Zhoupeng works with">
  <section class="container-site">
    <header class="bg-accent-soft mt-12 mb-10 rounded-card px-6 py-10 text-center">
      <h1 class="mb-1">Skills</h1>
      <p class="mb-0">What I work with, and where I've used it.</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        withUsage.map((group) => (
          <section class="bg-surface rounded-card p-6 shadow-card">
            <h2 class="text-2xl!">{group.title}</h2>
            <ul class="m-0 list-none space-y-4 p-0">
              {group.skills.map((skill) => (
                <li>
                  <p class="m-0 flex flex-wrap items-center gap-2 font-bold">
                    {skill.name}
                    {skill.learning && (
                      <span class="bg-accent-soft text-ink rounded-full px-2 py-0.5 text-xs font-medium">Learning</span>
                    )}
                  </p>
                  {(skill.used.length > 0 || skill.note) && (
                    <p class="text-muted m-0 text-sm">
                      {skill.used.map((u, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={u.href}>{u.title}</a>
                        </>
                      ))}
                      {skill.note && <>{skill.used.length > 0 && ', '}{skill.note}</>}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>
