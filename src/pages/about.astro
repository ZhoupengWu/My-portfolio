---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.jpg';
import { LOCATION } from '../consts';
---

<Base title="About" description="About Wu Zhoupeng">
  <section class="container-site flex flex-col items-center gap-8 pt-16 md:flex-row">
    <Image
      src={profile}
      alt="Autumn view over the rooftops of the city from a hill"
      widths={[400, 640, 800]}
      sizes="(min-width: 48rem) 20rem, 90vw"
      loading="eager"
      class="shadow-card aspect-[4/3] w-full max-w-sm shrink-0 rounded-card object-cover md:w-80"
    />
    <div>
      <h1>I'm Wu.</h1>
      <p class="max-w-2xl text-[1.35rem]">
        {LOCATION ? `I'm a developer from ${LOCATION}.` : "I'm a developer."} I enjoy turning ideas into small, working projects.
      </p>
    </div>
  </section>
</Base>
