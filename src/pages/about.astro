---
import Base from '../layouts/Base.astro';
import { LOCATION } from '../consts';
---

<Base title="About" description="About Wu Zhoupeng">
  <section class="container about">
    <h1>I'm Wu.</h1>
    <p class="lead">I'm a developer from {LOCATION}. I enjoy turning ideas into small, working projects.</p>
  </section>
</Base>

<style>
  .about {
    padding-top: 4rem;
  }
  .lead {
    font-size: 1.35rem;
    max-width: 40rem;
  }
</style>
