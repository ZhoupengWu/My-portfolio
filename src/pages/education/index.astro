---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EducationCard from '../../components/EducationCard.astro';
import { STATUS_LABELS, formatDate } from '../../utils';

const entries = (await getCollection('education', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// In-progress work first; a group heading is only shown when there is more than one group.
const groups = (['in-progress', 'completed'] as const)
  .map((status) => ({ status, items: entries.filter((e) => e.data.status === status) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Education" description="Repositories where Wu Zhoupeng learns new languages and tools">
  <section class="container-site">
    <header class="mt-12 mb-10 text-center">
      <h1 class="mb-0">Education</h1>
    </header>

    {
      groups.length > 0 ? (
        <div class="flex flex-col gap-12">
          {groups.map(({ status, items }) => (
            <div>
              {groups.length > 1 && <h2 class="mb-5">{STATUS_LABELS[status]}</h2>}
              <div class="flex flex-col gap-6">
                {items.map(({ id, data }) => (
                  <EducationCard
                    href={`/education/${id}`}
                    title={data.title}
                    description={data.description}
                    status={data.status}
                    started={formatDate(data.date)}
                    technologies={data.technologies}
                    topics={data.topics}
                    repo={data.repo}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-muted text-center">Nothing here yet.</p>
      )
    }
  </section>
</Base>
