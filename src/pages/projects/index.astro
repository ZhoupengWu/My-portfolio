---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Projects" description="Some projects made by Wu Zhoupeng">
  <section class="container-site">
    <header class="bg-accent-soft mt-12 mb-10 rounded-card px-6 py-10 text-center">
      <h1 class="mb-1">Projects</h1>
      <p class="mb-0">Some things I've built.</p>
    </header>

    {
      projects.length > 0 ? (
        <div class="grid grid-cols-[repeat(auto-fill,minmax(18rem,1fr))] gap-6">
          {projects.map(({ id, data }, i) => (
            <ProjectCard
              href={`/projects/${id}`}
              title={data.title}
              description={data.description}
              label={data.category}
              technologies={data.technologies}
              cover={data.cover}
              coverAlt={data.coverAlt}
              coverFit={data.coverFit}
              eager={i < 3}
            />
          ))}
        </div>
      ) : (
        <p class="text-muted text-center">Projects are coming soon.</p>
      )
    }
  </section>
</Base>
