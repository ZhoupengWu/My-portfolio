---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryDetail from '../../components/EntryDetail.astro';
import { formatPeriod } from '../../utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, date, endDate, technologies, category, cover, coverAlt, coverFit, repo, demo } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={description}>
  <EntryDetail
    {title}
    backHref="/projects"
    backLabel="All projects"
    details={[
      { label: 'Date', value: formatPeriod(date, endDate) },
      { label: 'Technologies', value: technologies.join(', ') },
      { label: 'Category', value: category },
    ]}
    {cover}
    {coverAlt}
    {coverFit}
    {repo}
    {demo}
  >
    <Content />
  </EntryDetail>
</Base>
