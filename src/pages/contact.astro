---
import Base from '../layouts/Base.astro';
import { LOCATION, SOCIALS } from '../consts';
---

<Base title="Contact" description="How to reach Wu Zhoupeng">
  <section class="container">
    <div class="page-title">
      <h3>Contact</h3>
      <h1>How to reach me</h1>
    </div>
    <div class="grid">
      <div>
        <h2>Location</h2>
        <p class="strong">{LOCATION}</p>
      </div>
      <div>
        <h2>Social</h2>
        <ul>
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} rel="noopener noreferrer" target="_blank">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-title h3 {
    margin-bottom: 0.25rem;
  }
  .grid {
    display: grid;
    gap: 2rem;
    text-align: center;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .strong,
  a {
    color: var(--link);
    font-weight: 700;
    font-size: 1.25rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover {
    color: var(--fucsia);
  }
</style>
