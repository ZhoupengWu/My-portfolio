---
import Base from '../layouts/Base.astro';
import { LOCATION } from '../consts';
---

<Base title="Contact" description="How to reach Wu Zhoupeng">
  <section class="container-site">
    <div class="mt-12 mb-8">
      <h3 class="mb-1">Contact</h3>
      <h1>How to reach me</h1>
    </div>
    {
      LOCATION && (
        <div class="text-center">
          <h2>Location</h2>
          <p class="text-link text-xl font-bold">{LOCATION}</p>
        </div>
      )
    }
  </section>
</Base>
