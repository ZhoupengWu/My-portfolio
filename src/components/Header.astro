---
import { NAV_LINKS, SITE_TITLE } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="bg-surface-alt mx-auto w-full max-w-site rounded-b-card">
  <div class="flex flex-wrap items-center justify-between px-5 py-3.5">
    <a class="text-brand text-2xl no-underline" href="/">{SITE_TITLE}</a>
    <button
      class="menu-toggle border-line flex cursor-pointer flex-col gap-1 rounded-lg border p-2 sm:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Toggle navigation"
    >
      <span class="bg-ink block h-0.5 w-[22px]"></span>
      <span class="bg-ink block h-0.5 w-[22px]"></span>
      <span class="bg-ink block h-0.5 w-[22px]"></span>
    </button>
    <nav id="site-nav" aria-label="Main" class="hidden w-full pt-3 data-[open]:block sm:block sm:w-auto sm:pt-0">
      <ul class="m-0 flex list-none flex-col gap-2 p-0 sm:flex-row sm:gap-6">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="text-ink border-b-[3px] border-transparent py-1 no-underline transition-colors duration-200 hover:text-fucsia aria-[current=page]:border-fucsia aria-[current=page]:font-bold"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.toggleAttribute('data-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
