---
// Switches between the light and dark palette. The saved choice is applied before first paint
// by the inline script in Base.astro; this component only handles the button.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Switch to dark theme"
  class="border-line bg-surface-alt text-ink grid size-10 shrink-0 cursor-pointer place-items-center rounded-full border transition-colors duration-200 hover:bg-accent-soft"
>
  <!-- Moon: shown in the light theme -->
  <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current [[data-theme=dark]_&]:hidden" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <!-- Sun: shown in the dark theme -->
  <svg viewBox="0 0 24 24" aria-hidden="true" class="hidden size-5 fill-none stroke-current [[data-theme=dark]_&]:block" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const syncLabel = () => {
    const label = root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    button?.setAttribute('aria-label', label);
    button?.setAttribute('title', label);
  };

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    // Switch every color at once instead of letting each element fade on its own.
    root.classList.add('no-transitions');
    root.dataset.theme = next;
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('no-transitions')));
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be blocked; the choice then lasts for this page only.
    }
    syncLabel();
  });

  // Without a saved choice, follow the OS preference when it changes.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem('theme')) return;
    } catch {
      // ignore
    }
    root.dataset.theme = event.matches ? 'dark' : 'light';
    syncLabel();
  });

  syncLabel();
</script>
