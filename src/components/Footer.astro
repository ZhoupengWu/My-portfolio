---
import { COPYRIGHT_YEARS, SITE_TITLE, SOCIALS } from '../consts';
---

<footer class="mt-16 px-5 pb-5">
  <div
    class="border-line bg-surface shadow-card mx-auto flex max-w-site flex-col-reverse gap-4 rounded-card border px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
  >
    <p class="text-muted m-0 text-sm">&copy; {COPYRIGHT_YEARS} {SITE_TITLE}. All rights reserved.</p>

    {
      SOCIALS.length > 0 && (
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {SOCIALS.map((s) => (
            <li>
              <a
                class="border-line text-ink hover:bg-surface-alt block rounded-full border px-4 py-1.5 text-base no-underline transition-colors duration-200"
                href={s.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {s.label}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
