---
import { COPYRIGHT_YEARS, NAV_LINKS, SITE_TITLE, SOCIALS } from '../consts';
---

<footer class="mt-16 px-5 pb-5">
  <div class="border-line bg-surface shadow-card mx-auto max-w-site rounded-card border px-6 py-6 sm:px-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <nav aria-label="Footer">
        <ul class="m-0 -ml-3.5 flex list-none flex-wrap gap-x-1 gap-y-1 p-0">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  class="text-ink hover:bg-surface-alt block rounded-full px-3.5 py-1.5 no-underline transition-colors duration-200"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        SOCIALS.length > 0 && (
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {SOCIALS.map((s) => (
              <li>
                <a
                  class="border-line text-ink hover:bg-surface-alt block rounded-full border px-4 py-1.5 text-base no-underline transition-colors duration-200"
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {s.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <p class="border-line text-muted m-0 mt-5 border-t pt-4 text-sm">&copy; {COPYRIGHT_YEARS} {SITE_TITLE}. All rights reserved.</p>
  </div>
</footer>
