---
import { SITE_TITLE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-line text-muted mt-16 border-t py-6">
  <div class="container-site flex flex-wrap items-center justify-between gap-3">
    <p class="m-0">&copy; {year} {SITE_TITLE}</p>
    <ul class="m-0 flex list-none gap-5 p-0">
      {
        SOCIALS.map((s) => (
          <li>
            <a class="text-muted transition-colors duration-200 hover:text-fucsia" href={s.href} rel="noopener noreferrer" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
