---
import { COPYRIGHT_YEARS, LOCATION, NAV_LINKS, SITE_TITLE, SOCIALS } from '../consts';
import Logo from './Logo.astro';
---

<footer class="mt-16 px-5 pb-5">
  <div class="border-line bg-surface shadow-card mx-auto max-w-site rounded-card border px-6 py-6 sm:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <Logo class="size-11 shrink-0" />
        <div class="leading-tight">
          <a href="/" class="text-ink text-xl font-bold no-underline transition-colors duration-200 hover:text-fucsia">{SITE_TITLE}</a>
          {LOCATION && <p class="text-muted m-0 text-base">{LOCATION}</p>}
        </div>
      </div>

      <nav aria-label="Footer">
        <ul class="m-0 flex list-none flex-wrap gap-x-1 gap-y-1 p-0">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  class="text-ink hover:bg-surface-alt block rounded-full px-3.5 py-1.5 no-underline transition-colors duration-200"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="border-line text-muted mt-6 flex flex-col gap-4 border-t pt-5 text-sm md:flex-row md:items-center md:justify-between">
      <div>
        <p class="m-0">&copy; {COPYRIGHT_YEARS} {SITE_TITLE}. All rights reserved.</p>
        <p class="m-0">Built with Astro and Tailwind CSS</p>
      </div>

      {
        SOCIALS.length > 0 && (
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {SOCIALS.map((s) => (
              <li>
                <a
                  class="border-line text-ink hover:bg-surface-alt block rounded-full border px-4 py-1.5 text-base no-underline transition-colors duration-200"
                  href={s.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {s.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
